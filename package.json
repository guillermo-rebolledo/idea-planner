{
  "name": "agents-ideas-prototypes",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "prototype": "vite prototypes/core-workspace",
    "prototype:subagents": "pnpm --filter argos-desktop exec vite --config prototype.vite.config.ts",
    "prototype:plan": "pnpm --filter argos-desktop exec vite --config run-plan.prototype.vite.config.ts",
    "prototype:project-source": "pnpm --filter argos-desktop exec vite --config project-source.prototype.vite.config.ts",
    "prototype:check": "tsc -p prototypes/core-workspace/tsconfig.json && vite build prototypes/core-workspace --outDir ../../dist/prototype --emptyOutDir && tsc -p prototypes/subagent-thread/tsconfig.json && tsc -p prototypes/run-plan/tsconfig.json && tsc -p prototypes/project-source/tsconfig.json",
    "codex:protocol": "rm -rf app/src/core/harness/codex-protocol && codex app-server generate-ts --out app/src/core/harness/codex-protocol",
    "codex:record": "node scripts/record-codex-session.mjs",
    "claude:probe-steer": "node scripts/probe-claude-steering.mjs",
    "package": "pnpm --filter argos-desktop package",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm prototype:check && pnpm --filter argos-desktop test",
    "prepare": "husky"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@effect/eslint-plugin": "^0.3.2",
    "@eslint-react/eslint-plugin": "^5.18.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/eslint-plugin": "^1.6.24",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.5"
  }
}
